namespace Z32

open BlockCert

/-- **The tip of the tongue, as a window statement.**  `Z_{3/2}(2/7, 3/7) = ∅`: no `ξ > 0` has
every `{ξ(3/2)ⁿ}` in `[2/7, 5/7)`, a window of length `3/7 = 0.428571…`.  This passes the corpus's
previous single-window record `Z32.ZSet_three_two_frontier` (`0.40722`, the hull-merge frontier)
and [Dub19] Theorem 1.2 (`31/81 = 0.38271…`, the longest window in print). -/
theorem ZSet_three_two_two_seven : FLP.ZSet 3 2 (2 / 7 : ℝ) (3 / 7) = ∅ := by
  refine ZSet_eq_empty_of_cert_base certTwoSeven_ok rfl rfl fun y h1 h2 => ?_
  refine ⟨(28697814, 71744535), by simp [certTwoSeven], ?_, ?_⟩ <;>
    simp only [certTwoSeven, rleR] <;> push_cast <;> linarith

/-- **The closed form, for every `ξ ≠ 0`.**  No `ξ ≠ 0` has every `{ξ(3/2)ⁿ}` in the *closed*
window `[2/7, 5/7]`.  The certificate is closed on the right, so this is genuinely stronger than
`Z32.ZSet_three_two_two_seven`, and it is the form the nearest-integer corollary needs. -/
theorem two_seven_empty {ξ : ℝ} (hξ : ξ ≠ 0) :
    ¬ ∀ n : ℕ, Int.fract (ξ * ((3 : ℝ) / 2) ^ n) ∈ Set.Icc (2 / 7 : ℝ) (5 / 7) := by
  intro h
  refine not_confined_base certTwoSeven_ok (3 / 2) (by norm_num [certTwoSeven]) hξ fun n => ?_
  obtain ⟨h1, h2⟩ := h n
  refine ⟨(28697814, 71744535), by simp [certTwoSeven], ?_, ?_⟩ <;>
    simp only [certTwoSeven, rleR] <;> push_cast <;> linarith

/-- **The eventual form** of `Z32.two_seven_empty`: the orbit leaves `[2/7, 5/7]` infinitely
often. -/
theorem not_eventually_two_seven {ξ : ℝ} (hξ : ξ ≠ 0) {N : ℕ} :
    ¬ ∀ n : ℕ, N ≤ n → Int.fract (ξ * ((3 : ℝ) / 2) ^ n) ∈ Set.Icc (2 / 7 : ℝ) (5 / 7) := by
  intro h
  refine Cert.not_eventually_confined certTwoSeven_ok hξ (N := N) fun n hn => ?_
  have hb : ((certTwoSeven.p : ℝ) / certTwoSeven.q) = 3 / 2 := by norm_num [certTwoSeven]
  rw [hb]
  obtain ⟨h1, h2⟩ := h n hn
  refine ⟨(28697814, 71744535), by simp [certTwoSeven], ?_, ?_⟩ <;>
    simp only [certTwoSeven, rleR] <;> push_cast <;> linarith

/-- **`‖ξ(3/2)ⁿ‖ < 2/7` infinitely often, for every `ξ ≠ 0`.**  The nearest-integer form of
`Z32.two_seven_empty`, `‖x‖ = |x - round x|`, and the point of the entry: the corpus's previous
constant of this shape was `1/3`, from the length-`1/3` line.

Against print it falls `6.7·10⁻⁵` short: [Dub06JNT] (Bugeaud, Cambridge Tract 193, Theorem 3.14)
gives every `ξ ≠ 0` a limit point of `(‖ξ(3/2)ⁿ‖)` at most `0.285647…`.  The engine reaches both
constants of that paper to five decimals and passes neither — compare
`Z32.not_forall_abs_sub_round_lt_238` on the other side. -/
theorem not_forall_two_seven_le_abs_sub_round {ξ : ℝ} (hξ : ξ ≠ 0) {N : ℕ} :
    ¬ ∀ n : ℕ, N ≤ n → (2 : ℝ) / 7 ≤ |ξ * ((3 : ℝ) / 2) ^ n - round (ξ * ((3 : ℝ) / 2) ^ n)| := by
  intro h
  refine not_eventually_two_seven hξ (N := N) fun n hnN => ?_
  have hn := h n hnN
  rw [abs_sub_round_eq_min, le_min_iff] at hn
  exact ⟨hn.1, by linarith [hn.2]⟩

end Z32
